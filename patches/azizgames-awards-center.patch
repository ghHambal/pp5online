+import React from 'react';
+export function AwardsLink() {
+  const embedded = location.pathname.endsWith('/azizgames.html');
+  const href = embedded ? new URL('sports-awards.html', location.href).href
+    : 'https://ghhambal.github.io/pp5online/sports-awards.html';
+  return <a href={href} target="_blank" rel="noopener noreferrer" className="inline-flex rounded-xl border border-amber-700 bg-amber-950 px-4 py-3 text-amber-100 font-bold">🏅 ศูนย์มอบเหรียญ ↗</a>;
+}
